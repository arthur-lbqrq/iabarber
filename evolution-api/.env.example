# ===========================================
# EVOLUTION API - ambiente local (iabarber)
# NÃO COMITAR ESTE ARQUIVO (contém credenciais)
# ===========================================

# --- Servidor ---
SERVER_NAME=iabarber-evolution
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://localhost:8080
SERVER_DISABLE_DOCS=false
SERVER_DISABLE_MANAGER=false

# --- CORS (liberado pra dev local) ---
CORS_ORIGIN=*
CORS_METHODS=POST,GET,PUT,DELETE
CORS_CREDENTIALS=true

# --- Banco de dados (Postgres interno da Evolution API, separado do Supabase do projeto) ---
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:troque-por-uma-senha-gerada@evolution-postgres:5432/evolution_api
DATABASE_CONNECTION_CLIENT_NAME=iabarber-evolution

POSTGRES_DATABASE=evolution_api
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=troque-por-uma-senha-gerada

DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=false

# --- Redis (cache/sessão) ---
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379
CACHE_REDIS_PREFIX_KEY=evolution-cache
CACHE_REDIS_TTL=604800
CACHE_REDIS_SAVE_INSTANCES=true

CACHE_LOCAL_ENABLED=false
CACHE_LOCAL_TTL=86400

# --- Autenticação da API (chave gerada com `openssl rand -hex 24`) ---
AUTHENTICATION_API_KEY=troque-por-uma-chave-gerada-com-openssl-rand-hex-24
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# --- Logs ---
LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=true
LOG_BAILEYS=error

# --- Instâncias ---
DEL_INSTANCE=false
DEL_TEMP_INSTANCES=true

# --- Idioma ---
LANGUAGE=pt-BR

# --- Webhook global (desligado por enquanto — o backend ainda não existe) ---
WEBHOOK_GLOBAL_URL=
WEBHOOK_GLOBAL_ENABLED=false
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false

# --- Websocket ---
WEBSOCKET_ENABLED=false
WEBSOCKET_GLOBAL_EVENTS=false

# --- Integrações externas: todas desligadas no MVP ---
RABBITMQ_ENABLED=false
NATS_ENABLED=false
SQS_ENABLED=false
PUSHER_ENABLED=false
TYPEBOT_ENABLED=false
CHATWOOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
N8N_ENABLED=false
EVOAI_ENABLED=false
FLOWISE_ENABLED=false
S3_ENABLED=false
PROMETHEUS_METRICS=false

# --- Telemetria (dados de uso anônimos enviados pra Evolution API) ---
TELEMETRY_ENABLED=false

# --- QR Code ---
QRCODE_LIMIT=30
QRCODE_COLOR=#198754

CONFIG_SESSION_PHONE_CLIENT=iabarber
CONFIG_SESSION_PHONE_NAME=Chrome
