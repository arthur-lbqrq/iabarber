# Variáveis usadas na interpolação do docker-compose.prod.yml em si (domínio e nomes
# do Postgres interno da Evolution API). Copie pra ".env" e preencha.
# NÃO COMITAR o ".env" real.

DOMAIN=seudominio.com

EVOLUTION_POSTGRES_DATABASE=evolution_api
EVOLUTION_POSTGRES_USERNAME=evolution
EVOLUTION_POSTGRES_PASSWORD=
